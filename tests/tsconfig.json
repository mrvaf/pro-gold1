{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@v-gold/core": ["../packages/core/src/index.ts"],
      "@v-gold/database": ["../packages/database/src/index.ts"],
      "@v-gold/ai-gateway": ["../packages/ai-gateway/src/index.ts"]
    }
  },
  "include": [
    "./**/*"
  ]
}
